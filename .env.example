# ─── API Server ────────────────────────
PORT=3001
NODE_ENV=development

# ─── Midnight Network ──────────────────
# Midnight testnet indexer endpoint
MIDNIGHT_INDEXER_URL=https://indexer.testnet.midnight.network/api/v1/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.testnet.midnight.network/api/v1/graphql/ws

# Midnight proof server (runs locally)
PROOF_SERVER_URL=http://localhost:6300

# Deployed contract address (fill after deployment)
CONTRACT_ADDRESS=<YOUR_DEPLOYED_ADDRESS_HERE>

# ─── Admin ─────────────────────────────
# Admin address (used for set_merkle_root circuit)
ADMIN_ADDRESS=<YOUR_ADMIN_ADDRESS_HERE>

# ─── Security ──────────────────────────
# Secret salt for commitment scheme (32 bytes hex)
COMMITMENT_SECRET=your_32_byte_secret_hex_here_change_me

# JWT secret for admin API endpoints
JWT_SECRET=your_jwt_secret_change_me_in_production

# ─── Privacy ───────────────────────────
# Proof expiry in seconds (default: 5 minutes)
PROOF_EXPIRY_SECONDS=300

# ─── Debug ─────────────────────────────
LOG_LEVEL=info
ENABLE_CORS=true
